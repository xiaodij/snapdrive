# no-transform: stops Cloudflare rewriting responses (it injects its Web Analytics beacon into
# HTML on this zone). The app promises scans stay on the device, so no third-party scripts.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: mediastream:; connect-src 'self' https://graph.microsoft.com https://*.microsoftpersonalcontent.com https://api.onedrive.com https://*.1drv.com https://*.sharepoint.com https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/tessdata/*
  Content-Type: application/octet-stream
